# Copie este archivo como .env y ajuste los valores.

# Proveedor que redacta las respuestas: «ollama» (local) o «claude» (API de Anthropic).
# Con «claude», Ollama sigue calculando los embeddings de la búsqueda.
LLM_PROVIDER=ollama

# Claude (solo si LLM_PROVIDER=claude). La key se crea en https://platform.claude.com
# No la comparta ni la suba a git: .env está en .gitignore.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Profundidad de razonamiento: low (más rápido y barato) | medium | high
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=64000

# Ollama local
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3
LLM_TEMPERATURE=0.2
LLM_NUM_CTX=8192
LLM_TIMEOUT_S=180
# Hilos de CPU para Ollama. 0 = automático. En Intel Core Ultra (núcleos P + E) Ollama
# solo cuenta los núcleos P (p. ej. 2) y va muy lento: pruebe con 8–10.
OLLAMA_NUM_THREAD=0

# Recuperación
RETRIEVAL_TOP_K=4
RETRIEVAL_MAX_PER_SOURCE=2
# Hay evidencia si coseno ≥ EVIDENCE_MIN_COSINE, o si BM25 ≥ EVIDENCE_MIN_BM25 y
# coseno ≥ EVIDENCE_MIN_COSINE_BM25. Sin vectores se usa solo BM25.
# Recalibrar con: .venv/bin/dilemabot-calibrar
EVIDENCE_MIN_BM25=7.0
EVIDENCE_MIN_COSINE=0.55
EVIDENCE_MIN_COSINE_BM25=0.45

# Memoria conversacional (turnos usuario+bot que se envían al modelo)
HISTORY_TURNS=6
